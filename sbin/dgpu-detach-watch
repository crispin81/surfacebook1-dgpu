#!/bin/bash
# Run `dgpu off` when the Surface Book 1 detach latch opens.
# Linux gets no detach event on the SB1, so watch for its side effects. Once
# the latch opens, the base stops powering the clipboard, with or without
# the charger (which plugs into the base):
#  - the clipboard battery (BAT1) discharges under the full load: several W,
#    against ~0.08W while docked or after simply unplugging the charger
#    (the base battery takes over then). power_now is unsigned, so BAT1 must
#    also report Discharging: plugging the charger in charges it at a
#    similar rate.
#  - the base battery (BAT2) may stop reporting a status at all.
# Each condition must hold for two samples in a row. Exits once the dGPU is
# gone. Started by `dgpu on`.
GPU=/sys/bus/pci/devices/0000:01:00.0
PS=/sys/class/power_supply
BAT1_DETACHED_UW=1500000

# Notify every logged-in user with a session bus.
notify() {
  local bus uid
  for bus in /run/user/*/bus; do
    [[ -S $bus ]] || continue
    uid=${bus#/run/user/}; uid=${uid%/bus}
    runuser -u "$(id -nu "$uid")" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
      notify-send -u critical -a dgpu "$@" || true
  done
}

hits=0
while [[ -e $GPU ]]; do
  sleep 0.5
  bat1=$(cat $PS/BAT1/power_now 2>/dev/null || echo 0)
  bat1_status=$(cat $PS/BAT1/status 2>/dev/null)
  bat2_status=$(cat $PS/BAT2/status 2>/dev/null)

  reason=
  if [[ $bat1_status == Discharging ]] && (( bat1 > BAT1_DETACHED_UW )); then
    reason="screen battery carrying the load (BAT1=${bat1}uW)"
  elif [[ -z $bat2_status ]]; then
    reason="base battery stopped reporting"
  fi

  if [[ -n $reason ]]; then hits=$((hits + 1)); else hits=0; fi
  (( hits >= 2 )) || continue

  logger -t dgpu-detach-watch "detach detected: $reason"
  if /usr/local/bin/dgpu off >/dev/null; then
    notify "dGPU powered off" "Detach detected - safe to lift the screen."
  else
    notify "dGPU still in use!" "Close apps using the NVIDIA GPU before detaching."
    sleep 5
  fi
done
