#!/bin/bash
# Toggle the Surface Book dGPU from the bar.
if [[ -e /sys/bus/pci/devices/0000:01:00.0 ]]; then action=off; else action=on; fi
notify-send -a dgpu -t 3000 "dGPU" "Powering $action…"
if out=$(sudo -n /usr/local/bin/dgpu "$action" 2>&1); then
  notify-send -a dgpu "dGPU $action" "$(tail -1 <<<"$out")"
else
  notify-send -a dgpu -u critical "dGPU $action failed" "$(tail -2 <<<"$out")"
fi
